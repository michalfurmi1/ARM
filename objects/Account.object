    <fields>
        <fullName>Business_Size__c</fullName>
        <inlineHelpText>Business size refers to the size of a company’s operations.</inlineHelpText>
        <label>Business Size</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Micro-sized business: less than 10 employees</fullName>
                    <default>false</default>
                    <label>Micro-sized business: less than 10 employees</label>
                </value>
                <value>
                    <fullName>Small-sized business: 10-49 employees</fullName>
                    <default>false</default>
                    <label>Small-sized business: 10-49 employees</label>
                </value>
                <value>
                    <fullName>Medium business: 50-249 employees</fullName>
                    <default>false</default>
                    <label>Medium business: 50-249 employees</label>
                </value>
                <value>
                    <fullName>Large-sized business: more than 250 employees.</fullName>
                    <default>false</default>
                    <label>Large-sized business: more than 250 employees.</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CRMforNonProfit__Account_Num__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
