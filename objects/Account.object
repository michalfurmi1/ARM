    <validationRules>
        <fullName>Account</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
   ISBLANK(  AccountNumber ),
   NOT(ISNUMBER(  AccountNumber ))
)</errorConditionFormula>
        <errorDisplayField>AccountNumber</errorDisplayField>
        <errorMessage>Account Number is not numeric.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Account_Number_Numeric</fullName>
        <active>false</active>
        <errorConditionFormula>OR(
ISBLANK(AccountNumber),
NOT(ISNUMBER(AccountNumber))
)</errorConditionFormula>
        <errorMessage>The account number should be Numeric</errorMessage>
    </validationRules>
