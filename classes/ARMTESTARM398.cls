public class ARMTESTARM398 {    public static void hello() {        System.debug('Hello, World!');        Integer x = 10;        Integer y = 20;        Integer result = x + y;        System.debug('The result of x + y is: ' + result);        List<String> names = new List<String>{'Alice', 'Bob', 'Charlie'};        for(String name : names) {            System.debug('Name: ' + name);        }        Map<String, Integer> ageMap = new Map<String, Integer>();        ageMap.put('Alice', 30);        ageMap.put('Bob', 25);        ageMap.put('Charlie', 35);        for(String key : ageMap.keySet()) {            System.debug(key + ' is ' + ageMap.get(key) + ' years old');        }        Integer sum = 0;        for(Integer i = 1; i <= 5; i++) {            sum += i;        }        System.debug('Sum of numbers from 1 to 5: ' + sum);    }}